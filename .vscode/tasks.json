{
    "presentation": {
        "echo": false,
        "reveal": "always",
        "focus": true,
        "panel": "shared",
        "clear": true,
        "showReuseMessage": false
    },
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run All",
            "dependsOn": [
                "Compile",
                "Execute"
            ],
            "dependsOrder": "sequence",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "Compile",
            "type": "shell",
            "command": "C:\\msys64\\ucrt64\\bin\\g++.exe",
            "args": [
                "-std=c++17",
                "-O2",
                "-Wall",
                "${file}",
                "-o",
                "${workspaceFolder}\\a.exe"
            ],
            "problemMatcher": []
        },
        {
            "label": "Execute",
            "type": "shell",
            "command": "cmd.exe",
            "args": [
                "/c",
                "\"${workspaceFolder}\\a.exe\" < \"${workspaceFolder}\\input.txt\" > \"${workspaceFolder}\\output.txt\" && type \"${workspaceFolder}\\output.txt\""
            ]
        }
    ]
}

// cp then ctrl + space to get the cpp boilerplate